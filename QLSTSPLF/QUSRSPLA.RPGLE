**free
/if not defined(QUSRSPLA)
/define QUSRSPLA

//  Retrieve Spooled File Attributes (QUSRSPLA) API
dcl-pr QUSRSPLA extpgm('QUSRSPLA');
  i_rcvVar    char(65535) options(*varsize);
  i_lenRcvVar int(10) const;
  i_format    char(8) const;
  i_qJob      char(26) const;
  i_intJobId  char(16) const;
  i_intSplFId char(16) const;
  i_splF      char(10) const;
  i_splFNbr   int(10) const;
  io_errCode  char(65535) options(*nopass: *varsize); // | optGrp 1
end-pr;

//  SPLA0100 Format
dcl-ds spla0100_t qualified template;
  bytRet        int(10);
  bytAvl        int(10);
  intJobId      char(16);
  intSplFId     char(16);
  job           char(10);
  user          char(10);
  jobNbr        char(6);
  splF          char(10);
  splFNbr       int(10);
  formType      char(10);
  userData      char(10);
  status        char(10);
  available     char(10);
  hold          char(10);
  save          char(10);
  pages         int(10);
  currPage      int(10);
  startPage     int(10);
  endPage       int(10);
  lastPagePrint int(10);
  restart       int(10);
  copies        int(10);
  copiesLeft    int(10);
  lpi           int(10);
  cpi           int(10);
  priority      char(2);
  outQNm        char(10);
  outQLib       char(10);
  dateOpened    char(7);
  timeOpened    char(6);
  deviceFileNm  char(10);
  deviveFileLib char(10);
  pgmOpnFileNm  char(10);
  pgmOpnFileLib char(10);
  accCode       char(15);
  printText     char(30);
  rcdLen        int(10);
  maxRcds       int(10);
  devType       char(10);
  printDevType  char(10);
  document      char(12);
  folder        char(64);
  s36ProcName   char(8);
  fidelity      char(10);
  rplUnprtChars char(1);
  rplChar       char(1);
  pageLength    int(10);
  pageWidth     int(10);
  numSeparators int(10);
  pageOverflow  int(10);
  multyByteChar char(10);
  dbcsExtChar   char(10);
  dbcsShiftIO   char(10);
  dbcsCharRot   char(10);
  dbcsCPI       int(10);
  graphCharSet  char(10);
  codePage      char(10);
  formDefNm     char(10);
  formDefLib    char(10);
  srcDrawer     int(10);
  prtFont       char(10);
  s36SplFId     char(6);
  pageRot       int(10);
  justification int(10);
  duplex        char(10);
  foldRecords   char(10);
  ctrlChar      char(10);
  alignForms    char(10);
  quality       char(10);
  formFeed      char(10);
  volumes       char(71);
  fileLabelId   char(17);
  exchangeType  char(10);
  charCode      char(10);
  totRcds       int(10);
  pagesPerSide  int(10);
  fontOvrNm     char(10);
  fontOvrLib    char(10);
  fontOvrDwn    packed(15: 5);
  fonrOvrAcr    packed(15: 5);
  backOvrNm     char(10);
  backOvrLib    char(10);
  backOvrDwn    packed(15: 5);
  backOvrAcr    packed(15: 5);
  unitMeasure   char(10);
  pageDefNm     char(10);
  pageDefLib    char(10);
  lineSpacing   char(10);
  fontSize      packed(15: 5);
  fontMgnDwn    packed(15: 5);
  fontMgnAcr    packed(15: 5);
  backMgnDwn    packed(15);
  backMgnAcr    packed(15: 5);
  lengthOfPage  packed(15: 5);
  widthOfPage   packed(15: 5);
  measureMethod char(10);
  afp           char(1);
  charsetNm     char(10);
  charsetLib    char(10);
  codePageNm    char(10);
  codePageLib   char(10);
  codeFontNm    char(10);
  codeFontLib   char(10);
  dbcsCdeFntNm  char(10);
  dbcsCdeFntLib char(10);
  usrDefFile    char(10);
  reduceOutput  char(11);
  outputBin     int(10);
  ccsid         int(10);
  usrDefText    char(100);
  systemCreated char(8);
  idCreated     char(8);
  userCreated   char(10);
  reserved_1    char(2);
  offsUsrDefOpt int(10);
  numUsrDefOpt  int(10);
  lenUsrDefOptE int(10);
  usrDefData    char(255);
  usrDefObjNm   char(10);
  usrDefObjLib  char(10);
  usrObjType    char(10);
  reserved_2    char(3);
  charSetPntSze packed(15: 5);
  codFntPntSze  packed(15: 5);
  dbcsCdFnPnSze packed(15: 5);
  auxStgPool    int(10);
  splFSize      int(10);
  splFSizeMlt   int(10);
  iNetPPJobId   int(10);
  splFCrtSecMtd char(1);
  splFCrtAutMtd char(1);
  startPrcDate  char(7);
  startPrcTime  char(6);
  endPrcDate    char(7);
  endPrcTime    char(6);
  jobSystem     char(8);
  devAuxPool    char(10);
  expDate       char(7);
end-ds;

/endif
