 RAD  ***
 RAD  *
 RAD A          R SPLF0100                  TEXT('QUSLSPL API - SPLF0100')
 RAD  *
 RAD A            USER          10A         TEXT('User name                   ')
 RAD A            OUTQ          10A         TEXT('Output queue name           ')
 RAD A            OUTQLIB       10A         TEXT('Output queue library name   ')
 RAD A            FORMTYPE      10A         TEXT('Form type                   ')
 RAD A            USRDTA        10A         TEXT('User-specified data         ')
 RAD A            INTJOBID      16A         TEXT('Internal job identifier     ')
 RAD A            INTSPLFID     16A         TEXT('Internal spooled file ident.')
 RAD A            RES01          2A         TEXT('Reserved                    ')
 RAD A            AUXSTGPOOL     9B 0       TEXT('Auxiliary storage pool      ')
 RAD  *
